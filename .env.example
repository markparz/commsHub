# App
# Each person picks a local host port (comms-hub-ops skill reads this).
HOST_PORT=8082
NEXT_PUBLIC_APP_URL=http://localhost:8082
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Demo mode (no OAuth) — set to "false" once credentials below are configured
NEXT_PUBLIC_DEMO_MODE=true

# Google Cloud OAuth (Gmail + Calendar)
# Create at https://console.cloud.google.com/apis/credentials
# Enable Gmail API + Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8082/api/auth/google/callback

# Slack — pick ONE of these approaches:

# A) Bot token (simplest): install the app to your workspace, then paste the
#    Bot User OAuth Token (starts with xoxb-) from OAuth & Permissions
SLACK_BOT_TOKEN=

# B) Browser OAuth: Connect Slack button in the UI
# Create at https://api.slack.com/apps — add redirect URL below
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8082/api/auth/slack/callback

# Team Status pane — shared via data/team-status.json + git commit/push
# Point at the git checkout so posts can pull/commit/push for the whole team
STATUS_REPO_ROOT=
STATUS_AUTHOR=
STATUS_GIT_SYNC=true
STATUS_GIT_AUTHOR_NAME=Comms Hub
STATUS_GIT_AUTHOR_EMAIL=comms-hub@localhost
# Optional: GitHub token for container/local push (or set GH_TOKEN)
STATUS_GIT_TOKEN=

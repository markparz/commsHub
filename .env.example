# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Demo mode (no OAuth) — set to "false" once credentials below are configured
NEXT_PUBLIC_DEMO_MODE=true

# Google Cloud OAuth (Gmail + Calendar)
# Create at https://console.cloud.google.com/apis/credentials
# Enable Gmail API + Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Slack app OAuth
# Create at https://api.slack.com/apps — add redirect URL below
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/auth/slack/callback
